use ard/testing

use kb/collections
use go:kb/ffi/fs
use go:kb/ffi/sqlite
use kb/store
use go:os
use go:path/filepath
use go:regexp
use go:strings

let qmd_brace_range_pattern: mut regexp::Regexp = regexp::MustCompile(
  "\\{{[^{{}}]*\\.\\.[^{{}}]*\\}}",
)

fn export_config(database: store::Store) Str!Error {
  database.db.ExportConfigJSON()
}

fn contains(values: [Str], candidate: Str) Bool {
  mut found = false
  for value in values {
    if value == candidate {
      found = true
    }
  }
  found
}

fn validation_error(message: Str) Error {
  Error::new(message)
}

fn validate_config(source: sqlite::ConfigFile) sqlite::ConfigFile!Error {
  try testing::assert(
    source.Version == 1,
    "unsupported config version {source.Version}",
  ).map_err(validation_error)
  try testing::assert(
    source.CollectionsPresent,
    "config collections must be an explicit JSON array",
  ).map_err(validation_error)
  let names: mut [Str] = mut []
  let validated: mut [sqlite::ConfigCollection] = mut []
  for item in source.Collections {
    let name = try collections::normalize_name(item.Name)
    let name_key = strings::ToLower(name)
    try testing::assert(
      not contains(names.@, name_key),
      "duplicate collection name {name}",
    ).map_err(validation_error)
    names.push(name_key)
    try testing::assert(
      not item.RootPath.is_empty(),
      "collection {name} root_path is required",
    ).map_err(validation_error)
    let root = try fs::CanonicalDirectory(item.RootPath)
    try testing::assert(
      not item.GlobPattern.is_empty(),
      "collection {name} has an empty glob",
    ).map_err(validation_error)
    let ignores: mut [Str] = mut []
    for pattern in item.IgnorePatterns {
      try testing::assert(
        not pattern.is_empty(),
        "collection {name} has an empty ignore pattern",
      ).map_err(validation_error)
      ignores.push(pattern)
    }
    try fs::ValidatePatterns(item.GlobPattern, ignores)
    let prefixes: mut [Str] = mut []
    let contexts: mut [sqlite::ConfigContext] = mut []
    for context in item.Contexts {
      let prefix = strings::Trim(strings::TrimSpace(context.PathPrefix), "/")
      try testing::assert(
        not prefix == "." or prefix == ".." or strings::HasPrefix(prefix, "../") or strings::Contains(prefix, "/../"),
        "collection {name} has invalid context prefix {prefix}",
      ).map_err(validation_error)
      try testing::assert(
        not contains(prefixes.@, prefix),
        "collection {name} has duplicate context prefix {prefix}",
      ).map_err(validation_error)
      prefixes.push(prefix)
      contexts.push(sqlite::ConfigContext{PathPrefix: prefix, Description: context.Description})
    }
    validated.push(
      sqlite::ConfigCollection{
        Name: name,
        RootPath: root,
        GlobPattern: item.GlobPattern,
        IgnorePatterns: ignores.@,
        Contexts: contexts.@,
      },
    )
  }
  Result::ok(
    sqlite::ConfigFile{
      Version: source.Version,
      Collections: validated.@,
      CollectionsPresent: true,
    },
  )
}

fn import_config(database: store::Store, content: Str, replace: Bool) Int!Error {
  let decoded = try sqlite::DecodeConfigJSON(content)
  database.db.ImportConfig(try validate_config(decoded), replace)
}

fn has_top_level_comma(pattern: Str) Bool {
  mut brace_depth = 0
  mut bracket_depth = 0
  mut escaped = false
  mut found = false
  for character in pattern.runes() {
    match {
      escaped => { escaped = false },
      character == '\\' => { escaped = true },
      character == '{' => { brace_depth =+ 1 },
      character == '}' and brace_depth > 0 => { brace_depth =- 1 },
      character == '[' => { bracket_depth =+ 1 },
      character == ']' and bracket_depth > 0 => { bracket_depth =- 1 },
      character == ',' and brace_depth == 0 and bracket_depth == 0 => { found = true },
      _ => (),
    }
  }
  found
}

fn unsupported_qmd_glob_syntax(pattern: Str) Str? {
  let syntax = mut Maybe::new<Str>()
  if has_top_level_comma(pattern) {
    syntax.set("comma unions")
  }
  if syntax.is_none() and strings::HasPrefix(pattern, "!") {
    syntax.set("leading negation")
  }
  if syntax.is_none() and qmd_brace_range_pattern.MatchString(pattern) {
    syntax.set("brace ranges")
  }
  for marker in ["@(", "!(", "+(", "?(", "*(", "[[:"] {
    if syntax.is_none() and strings::Contains(pattern, marker) {
      syntax.set("extglob/POSIX classes")
    }
  }
  syntax.@
}

fn validate_qmd_pattern(collection: Str, kind: Str, pattern: Str) Void!Error {
  match unsupported_qmd_glob_syntax(pattern) {
    syntax => {
      Result::err(
        Error::new("QMD collection {collection} uses unsupported {syntax} in {kind} {pattern}"),
      )
    },
    _ => Result::ok(()),
  }
}

fn qmd_ignore_patterns(collection: Str, configured: [Str]) [Str]!Error {
  let defaults = [
    "**/node_modules/**",
    "**/.git/**",
    "**/.cache/**",
    "**/vendor/**",
    "**/dist/**",
    "**/build/**",
  ]
  let patterns: mut [Str] = mut []
  for pattern in defaults {
    if not contains(patterns.@, pattern) {
      patterns.push(pattern)
    }
  }
  for pattern in configured {
    try validate_qmd_pattern(collection, "ignore pattern", pattern)
    if not contains(patterns.@, pattern) {
      patterns.push(pattern)
    }
  }
  Result::ok(patterns.@)
}

fn import_qmd_config(
  database: store::Store,
  content: Str,
  base_directory: Str,
  replace: Bool,
  include_nondefault: Bool,
) sqlite::QMDImportResult!Error {
  let source = try sqlite::DecodeQMDConfigYAML(content)
  let absolute_base = try filepath::Abs(base_directory)
  let warnings: mut [Str] = mut []
  if source.ModelsPresent {
    warnings.push("QMD model settings were not imported; kb lexical search does not require models")
  }
  if not source.EditorURI.is_empty() or not source.EditorURITemplate.is_empty() or not source.EditorURICamel.is_empty() or not source.EditorURIKebab.is_empty() {
    warnings.push("QMD editor URI settings were not imported")
  }
  mut muted_collections = 0
  let converted: mut [sqlite::ConfigCollection] = mut []
  for item in source.Collections {
    let name = try collections::normalize_name(item.Name)
    let included_by_default = match item.IncludeByDefaultSet {
      true => item.IncludeByDefault,
      false => true,
    }
    if not included_by_default and not include_nondefault {
      let existing = try database.db.LookupCollection(name)
      try testing::assert(
        not existing.Found,
        "collection {name} already exists in kb but QMD marks it includeByDefault=false; remove it or pass --include-nondefault",
      ).map_err(validation_error)
      warnings.push(
        "collection {name} was skipped because includeByDefault=false; pass --include-nondefault to import it",
      )
      muted_collections =+ 1
    } else {
      try testing::assert(
        not item.Path.is_empty(),
        "QMD collection {name} has no path",
      ).map_err(validation_error)
      let root = match filepath::IsAbs(item.Path) {
        true => item.Path,
        false => filepath::Join(absolute_base, item.Path),
      }
      let pattern = match item.Pattern.is_empty() {
        true => "**/*.md",
        false => item.Pattern,
      }
      try validate_qmd_pattern(name, "pattern", pattern)
      let ignores = try qmd_ignore_patterns(name, item.Ignore)
      let contexts: mut [sqlite::ConfigContext] = mut []
      mut root_context = source.GlobalContext
      for context in item.Contexts {
        let prefix = strings::Trim(strings::TrimSpace(context.PathPrefix), "/")
        if prefix.is_empty() {
          root_context = context.Description
        } else {
          contexts.push(sqlite::ConfigContext{PathPrefix: prefix, Description: context.Description})
        }
      }
      if not root_context.is_empty() {
        contexts.push(sqlite::ConfigContext{PathPrefix: "", Description: root_context})
      }
      converted.push(
        sqlite::ConfigCollection{
          Name: name,
          RootPath: root,
          GlobPattern: pattern,
          IgnorePatterns: ignores,
          Contexts: contexts.@,
        },
      )
      if not item.Update.is_empty() {
        warnings.push("collection {name}: QMD update hook was not imported or executed")
      }
      if not included_by_default {
        warnings.push(
          "collection {name}: includeByDefault=false was explicitly broadened by --include-nondefault",
        )
      }
    }
  }
  try testing::assert(
    not replace or muted_collections == 0,
    "--replace would omit {muted_collections} includeByDefault=false collection(s); also pass --include-nondefault",
  ).map_err(validation_error)
  let validated = try validate_config(
    sqlite::ConfigFile{
      Version: 1,
      Collections: converted.@,
      CollectionsPresent: true,
    },
  )
  let names: mut [Str] = mut []
  for collection in validated.Collections {
    names.push(collection.Name)
  }
  let imported = try database.db.ImportConfig(validated, replace)
  Result::ok(
    sqlite::QMDImportResult{
      Imported: imported,
      Collections: names.@,
      Warnings: warnings.@,
    },
  )
}

private fn error_message(error: Error) Str {
  error.error()
}

test fn imports_qmd_collections_contexts_and_ignores_unsupported_settings() Void!Str {
  let directory = try os::MkdirTemp("", "kb-qmd-import-").map_err(error_message)
  defer os::RemoveAll(directory)
  let root = try os::MkdirTemp("", "kb-qmd-root-").map_err(error_message)
  defer os::RemoveAll(root)
  let database = try store::open_store("{directory}/index.sqlite").map_err(error_message)
  defer database.close()
  let _ = try database.migrate().map_err(error_message)
  let yaml = `
    global_context: Global fallback
    editor_uri: "vscode://file/{{path}}"
    models:
      embed: example/model
    collections:
      notes:
        path: {root}
        pattern: "**/*.md"
        ignore:
          - "archive/**"
        context:
          "/": Notes root
          projects: Project notes
        update: "git pull"
      muted:
        path: {root}
        includeByDefault: false
      " plain ":
        path: {root}
    `
  let imported = try import_qmd_config(database, yaml, directory, false, false).map_err(error_message)
  try testing::assert(
    imported.Imported == 2 and imported.Collections.size() == 2,
    "expected two QMD collections",
  )
  try testing::assert(imported.Warnings.size() == 4, "expected unsupported-setting warnings")
  let exported = try export_config(database).map_err(error_message)
  try testing::assert(
    exported.contains("\"name\": \"notes\"") and exported.contains("\"name\": \"plain\"") and (not exported.contains("\"name\": \"muted\"") and exported.contains("archive/**") and exported.contains("node_modules") and exported.contains("Notes root") and exported.contains("Project notes") and exported.contains("Global fallback")),
    "expected converted collection, ignore, and contexts",
  )
  let _ = try database.db.InsertCollection("muted", root, "**/*.md", mut []).map_err(error_message)
  try testing::assert(
    import_qmd_config(database, yaml, directory, false, false).is_err(),
    "skipped QMD collections must not leave an existing searchable collection",
  )
  let invalid = strings::ReplaceAll(yaml, root, "{root}/missing")
  try testing::assert(
    import_qmd_config(database, invalid, directory, false, true).is_err(),
    "missing QMD roots must fail before mutation",
  )
  let comma_union = strings::ReplaceAll(yaml, "**/*.md", "**/*.md,**/*.txt")
  try testing::assert(
    import_qmd_config(database, comma_union, directory, false, true).is_err(),
    "unsupported QMD comma-union patterns must fail loudly",
  )
  let extglob = strings::ReplaceAll(yaml, "**/*.md", "**/*.@(md|txt)")
  try testing::assert(
    import_qmd_config(database, extglob, directory, false, true).is_err(),
    "unsupported QMD extglob patterns must fail loudly",
  )
  let brace_range = strings::ReplaceAll(yaml, "**/*.md", "file{{1..3}}.md")
  try testing::assert(
    import_qmd_config(database, brace_range, directory, false, true).is_err(),
    "unsupported QMD brace ranges must fail loudly",
  )
  testing::pass()
}

test fn exports_and_atomically_imports_collection_configuration() Void!Str {
  let directory = try os::MkdirTemp("", "kb-config-").map_err(error_message)
  defer os::RemoveAll(directory)
  let root = try os::MkdirTemp("", "kb-config-root-").map_err(error_message)
  defer os::RemoveAll(root)
  let source = try store::open_store("{directory}/source.sqlite").map_err(error_message)
  defer source.close()
  let _ = try source.migrate().map_err(error_message)
  let canonical_root = try fs::CanonicalDirectory(root).map_err(error_message)
  let collection = try source.db.InsertCollection(
    "notes",
    canonical_root,
    "**/*.md",
    mut ["archive/**"],
  ).map_err(error_message)
  try source.db.UpsertCollectionContext(collection.ID, "guides", "Guide context").map_err(error_message)
  let exported = try export_config(source).map_err(error_message)
  try testing::assert(
    exported.contains("\"version\": 1") and exported.contains("Guide context"),
    "expected versioned collection configuration",
  )
  
  let target = try store::open_store("{directory}/target.sqlite").map_err(error_message)
  defer target.close()
  let _ = try target.migrate().map_err(error_message)
  try testing::assert(
    (try import_config(target, exported, false).map_err(error_message)) == 1,
    "expected one imported collection",
  )
  let round_trip = try export_config(target).map_err(error_message)
  try testing::assert(round_trip == exported, "expected deterministic round trip")
  let imported_collection = try target.db.LookupCollection("notes").map_err(error_message)
  let _ = try target.add_document(
    imported_collection.Collection.ID,
    "old.md",
    "Old",
    "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
    "old",
    "old",
    3,
    1,
  ).map_err(error_message)
  let changed_rules = strings::ReplaceAll(exported, "**/*.md", "**/*.txt")
  let _ = try import_config(target, changed_rules, false).map_err(error_message)
  let changed_status = try target.db.ReadStatus().map_err(error_message)
  try testing::assert(
    changed_status.Database.ActiveDocuments == 0 and changed_status.Database.InactiveDocuments == 0,
    "changed indexing rules must invalidate old documents",
  )
  try testing::assert(
    import_config(target, "{{\"version\":1,\"collections\":[],\"unknown\":true}}", false).is_err(),
    "expected unknown-field rejection",
  )
  try testing::assert(
    import_config(target, "{{\"version\":1}}", true).is_err(),
    "replacement requires an explicit collections array",
  )
  try testing::assert(
    import_config(target, "{{\"version\":1,\"collections\":null}}", true).is_err(),
    "replacement rejects a null collections value",
  )
  try testing::assert(
    import_config(
      target,
      "{{\"version\":1,\"collections\":[{{\"name\":\"bad\",\"glob_pattern\":\"**/*.md\",\"ignore_patterns\":[],\"contexts\":[]}}]}}",
      false,
    ).is_err(),
    "collection root_path is required",
  )
  try testing::assert(
    (try target.collections().map_err(error_message)).size() == 1,
    "failed import must not mutate current configuration",
  )
  try testing::assert(
    (try import_config(target, "{{\"version\":1,\"collections\":[]}}", true).map_err(error_message)) == 0,
    "expected empty replacement",
  )
  try testing::assert(
    (try target.collections().map_err(error_message)).size() == 0,
    "expected replacement removal",
  )
  testing::pass()
}
