use go:fmt
use go:kb/ffi/metrics
use go:kb/ffi/sqlite
use go:os
use go:path/filepath
use go:strings
use go:time

let document_count = 10_000
let search_iterations = 500

fn corpus() [sqlite::Document] {
  let documents: mut [sqlite::Document] = mut []
  for mut i = 0; i < document_count; i =+ 1 {
    let topic = match i % 4 {
      0 => "sqlite migrations transactions schema",
      1 => "ard goroutines channels worker pools",
      2 => "markdown headings links code blocks",
      _ => "full text search ranking knowledge base",
    }
    documents.push(
      sqlite::Document{
        Path: "collection/document-{i}.md",
        Title: "Technical note {i}",
        Body: "# Technical note {i}\n\n{topic}\n\n{strings::Repeat("Representative document text for indexing and retrieval. ", 8)}",
      },
    )
  }
  documents.@
}

fn run_benchmark() Void!Error {
  let temp_dir = try os::MkdirTemp("", "kb-fts5-benchmark-")
  defer os::RemoveAll(temp_dir)
  let database_path = filepath::Join(temp_dir, "index.sqlite")
  let db = try sqlite::Open(database_path)
  defer db.Close()
  try db.CreateIndex()
  
  let documents: mut [sqlite::Document] = mut corpus()
  let index_started = time::Now()
  try db.InsertDocuments(documents)
  let index_ms = time::Since(index_started).Milliseconds()
  
  let search_started = time::Now()
  for mut i = 0; i < search_iterations; i =+ 1 {
    let _ = try db.SearchSpike("sqlite migrations", 10)
  }
  let search_ns = metrics::AverageNanoseconds(time::Since(search_started), search_iterations)
  let heap_bytes = metrics::HeapAllocBytes()
  
  try db.Close()
  let info = try os::Stat(database_path)
  fmt::Println("documents={document_count}")
  fmt::Printf("cold_index_ms=%d\n", index_ms)
  fmt::Println("warm_search_avg_ns={search_ns}")
  fmt::Printf("database_bytes=%d\n", info.Size())
  fmt::Println("heap_alloc_bytes={heap_bytes}")
  Result::ok(())
}

fn main() {
  try run_benchmark() -> err {
    fmt::Println("Error: {err.error()}")
    os::Exit(1)
  }
}
